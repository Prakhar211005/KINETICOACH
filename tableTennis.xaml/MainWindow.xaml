<Window x:Class="KinectViz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KinectViz UDP Receiver"
        Width="950"
        Height="760">

    <Grid Margin="25">

        <StackPanel>

            <TextBlock Text="Table Tennis Trainer - Camera Data Receiver"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Listening on UDP Port 8888"
                       FontSize="18"
                       Margin="0,0,0,15"/>

            <Canvas x:Name="SkeletonCanvas"
                    Width="760"
                    Height="380"
                    Background="Black"
                    Margin="60,0,0,25">

            </Canvas>

            <TextBlock Text="Latest Received Data:"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="ReceivedDataText"
                       Text="No data received yet."
                       FontSize="18"
                       Margin="0,0,0,18"/>

            <TextBlock Text="Console Log:"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="LogBox"
                     Height="120"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

        </StackPanel>

    </Grid>
</Window>
